    {
      "type": "text",
      "version": 1,
      "id": "code-block",
      "x": 108,
      "y": 92,
      "width": 600,
      "height": 200,
      "text": "export async function listChallenges(\n  filter: ChallengeFilter\n): Promise<Challenge[]> {\n  const url = buildUrl('/challenges', filter);\n  const res = await fetch(url, {\n    headers: authHeaders(),\n  });\n  if (!res.ok) throw new ApiError(res);\n  return res.json();\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "strokeColor": "#d4d4d4",
      "opacity": 100,
      "seed": 310,
      "angle": 0,
      "strokeStyle": "solid",
      "roughness": 0,
      "groupIds": [],
      "frameId": null,
      "boundElements": null,
      "updated": 1772610021413,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "versionNonce": 1079190,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export async function listChallenges(\n  filter: ChallengeFilter\n): Promise<Challenge[]> {\n  const url = buildUrl('/challenges', filter);\n  const res = await fetch(url, {\n    headers: authHeaders(),\n  });\n  if (!res.ok) throw new ApiError(res);\n  return res.json();\n}",
      "lineHeight": 1.25,
      "textAlign": "left"
    },
